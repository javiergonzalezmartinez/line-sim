{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pharma-dt:canonical-event:2.0",
  "title": "Anonymous Pharmaceutical Operational Twin Canonical Event",
  "type": "object",
  "required": [
    "event_id",
    "event_class",
    "event_type",
    "action",
    "event_time",
    "record_time",
    "correlation_id",
    "object_ids",
    "result",
    "payload_hash",
    "schema_version"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_class": {
      "type": "string",
      "enum": [
        "OBJECT",
        "AGGREGATION",
        "ASSOCIATION",
        "TRANSFORMATION",
        "TRANSACTION",
        "CONTROL",
        "SENSOR"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "ADD",
        "OBSERVE",
        "DELETE",
        "EXECUTE"
      ]
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "record_time": {
      "type": "string",
      "format": "date-time"
    },
    "event_time_zone_offset": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence_no": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "object_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "quantity_list": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_point": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_order_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "batch_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "equipment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "person_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "OK",
        "REJECTED",
        "PARTIAL",
        "ERROR"
      ]
    },
    "sensor_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "measurement_type",
          "signal_quality",
          "source_timestamp",
          "server_timestamp"
        ],
        "properties": {
          "measurement_type": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "string_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "uom": {
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "min_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "max_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "std_dev": {
            "type": [
              "number",
              "null"
            ]
          },
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "exception": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_data_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "signal_quality": {
            "type": "string",
            "enum": [
              "GOOD",
              "UNCERTAIN",
              "BAD",
              "STALE"
            ]
          },
          "source_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "server_timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "signature_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "audit_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_before_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_after_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload_hash": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": true
}